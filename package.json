{
  "name": "danielemancini-cv",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Daniele Mancini — CV site (Apple-inspired), React + React Three Fiber + TypeScript",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode single",
    "release": "bun run build && bun run build:single && bun scripts/package.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/fiber": "^9.1.0",
    "lenis": "^1.1.20",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.172.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-singlefile": "^2.1.0"
  }
}
